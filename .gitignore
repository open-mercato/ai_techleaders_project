/.next/
**/.next/
/out/
**/out/

# production
/build
**/dist/
**/storybook-static/
**/debug-storybook.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# IDE
.idea

# vercel
.vercel

# typescript
*.tsbuildinfo
# Generated by `next dev`, `next build` and `next typegen`, and its contents differ
# between them: dev writes `import "./.next/dev/types/..."`, build rewrites the same
# lines to `./.next/types/...`. Committing either form means the other mode dirties a
# tracked file — a CI build job cannot leave the worktree clean, or every developer's
# dev server cannot. Next's own docs are explicit: "Add it to .gitignore. If your project
# already tracks the file, remove it from Git."
# (node_modules/next/dist/docs/01-app/03-api-reference/05-config/02-typescript.md)
# It stays in both tsconfig `include` arrays, as those docs also require.
packages/app/next-env.d.ts

# agent pipeline: commit durable `.ai` records, but never generated credentials
.ai/qa/test-env.env
.ai/qa/test-env-postgres.log

# skills installer staging copy (unrendered upstream download of .agents/skills)
/agent/

# per-developer Claude Code settings
.claude/settings.local.json

# generated local Storybook prototype
packages/ui/.storybook/public/prototypes/
