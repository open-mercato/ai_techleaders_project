# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
**/.next/
/out/
**/out/

# production
/build
**/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# agent pipeline (om-setup-agent-pipeline): per-run QA state, never source
.ai/qa/artifacts_*/
.ai/qa/test-env.json
.ai/qa/test-env.env

# skills installer staging copy (unrendered upstream download of .agents/skills)
/agent/

# per-developer Claude Code settings
.claude/settings.local.json
