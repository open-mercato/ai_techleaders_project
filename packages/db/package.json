{
  "name": "@devmentor/db",
  "version": "0.1.0",
  "private": true,
  "description": "DevMentor — MikroORM configuration, entities and migrations",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:list": "mikro-orm migration:list",
    "schema:update": "mikro-orm schema:update --run",
    "seed": "mikro-orm seeder:run",
    "seed:sessions": "mikro-orm seeder:run --class QaSessionSeeder"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "@mikro-orm/seeder": "^7.1.14",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.14",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  }
}
