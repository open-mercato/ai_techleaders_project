{
  "name": "@devmentor/ui",
  "version": "0.1.0",
  "private": true,
  "description": "DevMentor — shadcn-ui component library and design tokens",
  "type": "module",
  "scripts": {
    "storybook": "node ../../scripts/storybook/index.mjs dev --host 127.0.0.1 --port 6006 --no-open --ci --disable-telemetry",
    "build-storybook": "node ../../scripts/storybook/index.mjs build --disable-telemetry",
    "typecheck:storybook": "tsc --noEmit --project .storybook/tsconfig.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend/index.ts",
    "./time": "./src/time/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/ui/*.tsx"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
