# Copy to a private file such as deploy.env, fill every required value, and load it
# into Dokploy's Environment UI. Never commit the filled file.

APP_NAME=DevMentor
APP_URL=https://mentor.example.com
LOG_LEVEL=info
TRUSTED_PROXY_HOPS=1

POSTGRES_DB=devmentor
POSTGRES_USER=devmentor
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Add SESSION_SECRET_PREVIOUS only while rotating an existing secret. When present,
# it must also contain at least 32 characters.

MAIL_API_KEY=
MAIL_FROM=DevMentor <hello@example.com>

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPERATOR_EMAILS=
