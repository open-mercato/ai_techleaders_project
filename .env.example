# Connection string used by the app and by the MikroORM CLI.
# Copy to .env.local for local development:
#   docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17-alpine
#
# Integration tests ignore this: they provision their own throwaway container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Set to "true" to log every SQL statement.
MIKRO_ORM_DEBUG=false
