# Copy to `.env` and adjust. Consumed by @devmentor/core (app runtime) and the
# MikroORM CLI (@devmentor/db). Never commit the real `.env`.

# --- App ---
NODE_ENV=development
APP_NAME=DevMentor
LOG_LEVEL=info
# Absolute origin of this deployment. Used to build the GitHub OAuth redirect URI and
# the links in outbound mail, so it must be the address a browser actually reaches.
# Must start with http:// or https://.
APP_URL=http://localhost:3000
# How many reverse proxies sit in front of the app. The rate limiter takes the client
# IP this many hops from the right of `x-forwarded-for`; 0 trusts no forwarded header.
TRUSTED_PROXY_HOPS=0

# --- Mentor invitations ---
# Both values are snapshotted onto records, so changing them affects only future
# invitation creation or acceptance.
INVITATION_TTL_DAYS=14
MENTOR_PUBLISH_WINDOW_DAYS=14

# --- Platform pricing ---
# The first release supports PLN only. Bounds are integer cents for 25- and
# 50-minute sessions; the JSON must keep this exact shape and stay within 256 characters.
PLATFORM_CURRENCY=PLN
PLATFORM_PRICE_BOUNDS={"25":{"minCents":9000,"maxCents":60000},"50":{"minCents":18000,"maxCents":120000}}
# DevMentor's share of a paid session, in whole percent. The operator sets it (R10); the
# fee in force at confirmation is snapshotted onto the booking, so changing it here never
# rewrites what an earlier session owed.
PLATFORM_FEE_PERCENT=20

# --- Database ---
# Either set DATABASE_URL (takes precedence) ...
# DATABASE_URL=postgres://devmentor:devmentor@127.0.0.1:5432/devmentor
# ... or the discrete DB_* vars below. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=devmentor
DB_USER=devmentor
DB_PASSWORD=devmentor

# --- Connection pool ---
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Set to "true" to log SQL.
DB_DEBUG=false

# Whether the Migrator may (re)write the committed schema snapshot
# `packages/db/migrations/devmentor.json`. Leave it on: `db:migration:create` diffs the
# entities against that file, and `db:migrate`/`db:migrate:down` keep it current. The
# integration harnesses set it to "false" so a throwaway database cannot author a
# repository file. MikroORM's own MIKRO_ORM_MIGRATIONS_SNAPSHOT does not work here —
# file config outranks the environment unless `preferEnvVars` is set.
DB_MIGRATIONS_SNAPSHOT=true

# --- Sessions ---
# Signs every session cookie and every short-lived purpose token. At least 32
# characters; generate one with `openssl rand -base64 32`. Left unset here on purpose:
# a secret shared through a committed example is not a secret. Without it the app still
# builds, boots and serves public pages — sign-in fails closed — but a process started
# with NODE_ENV=production refuses to boot at all until it is set.
# SESSION_SECRET=
# Set to the outgoing value while rotating SESSION_SECRET. It is accepted on verify and
# never used to sign, so live sessions survive their remaining lifetime.
# SESSION_SECRET_PREVIOUS=

# --- Password hashing ---
# How many scrypt hashes may run at once in this process. The bound is memory, not CPU:
# at the parameters this project fixes (N=2^17, r=8, p=1) one hash holds 128 MiB for its
# whole duration, so 2 caps the hashing path at ~256 MiB. It cannot be unbounded — the
# rate limiter in front of it is keyed per IP and per email, so a few dozen addresses
# each within their own limit would otherwise be gigabytes at once. Raising this past
# UV_THREADPOOL_SIZE (4 by default) buys queueing rather than parallelism.
PASSWORD_HASH_CONCURRENCY=2
# How long a request waits for a free slot before the gate answers 503. 0 means never
# queue: refuse as soon as the limit is reached.
PASSWORD_HASH_WAIT_MS=2000

# --- GitHub OAuth ---
# From an OAuth app at https://github.com/settings/developers, with the callback URL
# set to <APP_URL>/api/auth/github/callback. Without them /api/auth/github fails closed
# by redirecting to /sign-in?error=unavailable; nothing else is affected.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Operators ---
# Comma-separated founder addresses. Operator authority is derived from this list on
# every request and matched case-insensitively against the account's verified email, so
# removing an address takes effect on that person's very next request.
OPERATOR_EMAILS=

# --- Mail ---
# Delivery is Resend's HTTP API. `resend` is the real adapter; leaving MAILER_ADAPTER
# unset in development selects the log mailer automatically (and warns at boot).
# MAILER_ADAPTER=resend
# MAIL_API_KEY=
# MAIL_FROM=DevMentor <hello@devmentor.example.com>

# --- Payments ---
# From https://dashboard.stripe.com/apikeys and the webhook endpoint's signing secret.
# Both optional: without STRIPE_SECRET_KEY the app boots and serves every page but uses a
# mock gateway that takes no money (and says so, loudly, at boot). The Checkout and webhook
# routes fail closed on a missing key rather than the process refusing to start.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Integration-test doubles (never set these on a real deployment) ---
# `AUTH_IDENTITY_ADAPTER=mock` turns sign-in into "sign in as whoever is asked for" and
# `MAILER_ADAPTER=log` writes emails to the log instead of delivering them. Either one
# without INTEGRATION_TEST_RUN=1 makes the app fail at boot rather than fall back to the
# real adapter. Only the literal `1` counts as the signal. The integration harness sets
# all of these itself; you should not need them locally.
# AUTH_IDENTITY_ADAPTER=mock
# INTEGRATION_TEST_RUN=1
