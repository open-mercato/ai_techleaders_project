{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "description": "DevMentor — monorepo root",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup/index.mjs",
    "invite": "tsx -e \"import('./scripts/invite.ts').then(({ evalArguments, main }) => main(evalArguments(process.argv)))\" --",
    "storybook": "npm run prototype && npm run storybook --workspace @devmentor/ui --",
    "build-storybook": "npm run prototype && npm run build-storybook --workspace @devmentor/ui",
    "typecheck:storybook": "npm run typecheck:storybook --workspace @devmentor/ui",
    "dev": "npm run dev --workspace @devmentor/app --",
    "build": "npm run build --workspace @devmentor/app",
    "deploy:preflight": "tsx -e \"import('@devmentor/core').then(({ assertProductionSecrets, getEnv }) => assertProductionSecrets(getEnv()))\"",
    "start": "npm run start --workspace @devmentor/app --",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:unit:coverage": "vitest run --config vitest.config.mts --coverage",
    "test:prototype": "node --test prototypes/devmentor-journey/prototype.test.mjs prototypes/devmentor-journey/navigation.test.ts && vitest run --config prototypes/devmentor-journey/vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:browser:install": "agent-browser install",
    "test:browser:install:ci": "agent-browser install --with-deps",
    "db:migration:create": "npm run migration:create --workspace @devmentor/db --",
    "db:migrate": "npm run migration:up --workspace @devmentor/db",
    "db:migrate:down": "npm run migration:down --workspace @devmentor/db",
    "db:schema:update": "npm run schema:update --workspace @devmentor/db",
    "db:seed": "npm run seed --workspace @devmentor/db",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prototype": "node scripts/build-prototype.mjs",
    "typecheck:prototype": "tsc --noEmit --project prototypes/devmentor-journey/tsconfig.json"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "4.1.11",
    "agent-browser": "0.36.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
