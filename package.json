{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "description": "DevMentor — monorepo root",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @devmentor/app --",
    "build": "npm run build --workspace @devmentor/app",
    "start": "npm run start --workspace @devmentor/app --",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migration:create": "npm run migration:create --workspace @devmentor/db --",
    "db:migrate": "npm run migration:up --workspace @devmentor/db",
    "db:migrate:down": "npm run migration:down --workspace @devmentor/db",
    "db:schema:update": "npm run schema:update --workspace @devmentor/db",
    "db:seed": "npm run seed --workspace @devmentor/db",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
